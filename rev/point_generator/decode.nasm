global _start

SECTION .rodata
  ; ↓ table where b64_table[char_ascii_value] = char_b64_value, and with 0xff for invalid values
  b64_table:   db     0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0x3e,0xff,0xff,0xff,0x3f,0x34,0x35,0x36,0x37,0x38,0x39,0x3a,0x3b,0x3c,0x3d,0xff,0xff,0xff,0x40,0xff,0xff,0xff,0x0,0x1,0x2,0x3,0x4,0x5,0x6,0x7,0x8,0x9,0xa,0xb,0xc,0xd,0xe,0xf,0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,0x18,0x19,0xff,0xff,0xff,0xff,0xff,0xff,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f,0x20,0x21,0x22,0x23,0x24,0x25,0x26,0x27,0x28,0x29,0x2a,0x2b,0x2c,0x2d,0x2e,0x2f,0x30,0x31,0x32,0x33,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff
  input_len:   equ    0x40
  out_len:     equ    0x40
; -------------------------------

SECTION .bss
  input:       resb   input_len
	out:         resb   out_len
; -------------------------------

SECTION .text
_start:
  ; ---[ syscall(read(STDIN, input, input_len)) ]--- ;
  xor rax, rax
  xor rdi, rdi
  mov rsi, input
  mov rdx, input_len
  syscall

  cmp rax, 1    ; if less that 1 bytes read
  jbe exit      ; exit

  dec rax       ; to ignore the newline

  xor rsi, rsi  ; needed for the loop below
  xor rcx, rcx  ; needed for the loop below
  xor r9, r9

  ; rbx  ->  loop counter
  ; r8   ->  index of char in input
  ; r9   ->  index of char in output
  ; cl   ->  missing bits (used cl because i need to shift bits with it)
  ; r10b ->  char
  ; r11  ->  mask (= (1 << r9) - 1, to extract the first r9 lsb bits of a number, to complete the missing char)
  ; dil  ->  output
  mov rbx, rax
  loop:
    cmp cl, 6                ; if (missing_bits != 6)
    jne missing_bits_not_6   ; don't reset missing bits and decrement i
      xor cl, cl  ; reset missing bits
      dec rbx     ; remove 1 from i (skip a char, that was previously entirely used)

    missing_bits_not_6:

    mov r8, rax   ; <-
    sub r8, rbx   ; <- r8 = len(input) - i  (current char index)

    mov r12, r8
    inc r12            ; <- to check if we aren't going to read too far. If we are, just skip the incomplete char
    cmp r12, rax       ; <- compare r8 + 1 and rax 
    je skip_loop       ; <- if (current char index + 1 == len(input)) { skip loop }

    mov r10b, byte [input + r8]       ; load input[char_index]

    cmp r10b, 0x3d     ; if input[char_index] == "="
    je skip_loop       ; skip the rest (padding)

    mov dil, byte [b64_table + r10]   ; translate char according to b64 table

    cmp dil, 0xff      ; if the input char is not a valid b64 character
    je exit            ; exit

    shl dil, 2    ; remove useless 00
    shl dil, cl   ; remove already used bits

    add cl, 2     ; add 2 to account for the 2 bits we removed

    mov r10b, byte [input + r8 + 1]   ; take next char to complete the previous one

    cmp r10b, 0x3d     ; if input[char_index] == "="
    je skip_loop       ; skip the rest (padding)

    mov r10b, byte [b64_table + r10]  ; translate char according to b64 table

    cmp dil, 0xff      ; if the input char is not a valid b64 character
    je exit            ; exit

    ; ↓ mask creation, to keep only the cl (missing bits) first bits of the next char
    mov r11b, 1   ; initialize to 1
    shl r11b, cl  ; shift cl (missing bits) bits
    dec r11b      ; substract 1

    add cl, 2  ; ↓ why can we only do that with cl :'(
    rol r10b, cl  ; move the interesting bits at the beginning
    sub cl, 2

    and r10b, r11b ; remove all the bits we don't care about

    add dil, r10b

    mov [out + r9], byte dil

    inc r9        ; increment index of output char

    cmp rbx, 0    ; for cases where missing bits = 6 before the last iteration
    je skip_loop  ; makes the instructions below wrap rbx to max and do stuff we don't want it to

    dec rbx        ; i--
    jnz loop       ; if i != 0, goto loop

  skip_loop:

  ; ---[ syscall(write(STDOUT, prompt, prompt_len)) ]--- ;
  mov rax, 1
  mov rdi, 1
  mov rsi, out
  mov rdx, out_len
  syscall

exit:
  ; ---[ syscall(exit(0)) ]--- ;
  mov rax, 60
  xor rdi, rdi
  syscall
